{
  "name": "super-loop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:deps": "node scripts/check-deps.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:deps",
    "clean": "turbo run clean",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "catalog:"
  }
}
